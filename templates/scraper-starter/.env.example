# scraper-starter — пример конфига. Скопируй в .env и подправь.

# HTTP
SCRAPER_USER_AGENT="MyBot/1.0 (+mailto:you@example.com)"
SCRAPER_TIMEOUT=15
SCRAPER_CONCURRENCY=10
SCRAPER_RATE_LIMIT_PER_SEC=1

# Retry
SCRAPER_MAX_RETRIES=5
SCRAPER_RETRY_MIN_WAIT=2
SCRAPER_RETRY_MAX_WAIT=30

# Proxy (опционально)
# SCRAPER_PROXY=http://user:pass@proxy:8080

# Storage
SCRAPER_OUT_DIR=data

# Logging
SCRAPER_LOG_LEVEL=INFO
SCRAPER_LOG_JSON=true

# Robots.txt
SCRAPER_RESPECT_ROBOTS=true
