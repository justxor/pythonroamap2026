# Async-starter environment
APP_ENV=local
LOG_LEVEL=INFO

# Postgres
DATABASE_URL=postgresql://user:pass@localhost:5432/app
DB_POOL_MIN=5
DB_POOL_MAX=20

# HTTP
HTTP_TIMEOUT=10
HTTP_MAX_CONNECTIONS=100

# Concurrency
MAX_CONCURRENT_REQUESTS=50

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=async-starter
